---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/manrope';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
// El nombre en Bricolage es el LCP: se precarga solo su archivo latino.
import displayFont from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import { perfil } from '../data/perfil';
import { grafoPerfil } from '../data/jsonld';

interface Props {
  title: string;
  description: string;
  /** Imagen para compartir, desde la raíz pública. Debe ser PNG de 1200×630: así se declara en
      og:image:type/width/height (la de por defecto la genera `pnpm og`). */
  image?: string;
  imageAlt?: string;
  /** La home es el perfil de una persona; el resto de páginas, 'website'. */
  ogType?: 'website' | 'profile';
  /** Páginas que no deben aparecer en Google (404). Sin canónica, og:url ni JSON-LD: la 404 se
      sirve en cualquier ruta, así que su URL de build (/404) no es la que se comparte. */
  noindex?: boolean;
  /** Imagen AVIF a precargar con prioridad alta (el LCP de la home en móvil es el póster). */
  preloadImage?: string;
}

// Canónica sin barra final, para que cada página tenga una sola URL.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
// `site` siempre viene de astro.config.mjs (SITE_URL o el dominio): sin él no hay URLs absolutas.
const site = Astro.site!;
const canonicalURL = new URL(path, site).href;

const {
  title,
  description,
  // Versionada en el nombre: LinkedIn, WhatsApp y X guardan la imagen por URL durante días; al
  // regenerarla (`pnpm og`) se sube el número para que la vuelvan a descargar.
  image = '/og/francisco-sanvicente-v2.png',
  // Solo la inicial del rol en minúscula: "Sumari" conserva su mayúscula.
  imageAlt = `${perfil.nombre}, ${perfil.rol.charAt(0).toLowerCase()}${perfil.rol.slice(1)}. ${perfil.ciudad}, ${perfil.pais}.`,
  ogType = path === '/' ? 'profile' : 'website',
  noindex = false,
  preloadImage,
} = Astro.props;

// Las redes leen la imagen desde fuera: tiene que ser absoluta.
const imageURL = new URL(image, site).href;

// Datos estructurados (ProfilePage → Person → Organization Sumari + WebSite): src/data/jsonld.ts.
const jsonLd = grafoPerfil({ site, canonical: canonicalURL, title, imagen: imageURL });
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={perfil.nombre} />
    {noindex ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonicalURL} />}
    <link rel="preload" href={displayFont} as="font" type="font/woff2" crossorigin />
    {preloadImage && <link rel="preload" href={preloadImage} as="image" type="image/avif" fetchpriority="high" />}
    <meta name="theme-color" content="#0B0C0E" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#F4F1EA" media="(prefers-color-scheme: light)" />
    {/* PNG de respaldo (Safari, Bing) y SVG para el resto; los PNG los genera `pnpm icons`. */}
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Open Graph (WhatsApp, LinkedIn, Facebook) y tarjeta de X. */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={perfil.nombre} />
    <meta property="og:locale" content="es_VE" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonicalURL} />}
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {
      ogType === 'profile' && (
        <>
          <meta property="profile:first_name" content={perfil.nombrePila} />
          <meta property="profile:last_name" content={perfil.apellidos} />
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {!noindex && <script type="application/ld+json" set:html={jsonLdText} />}

    {/* `html.js` habilita lo que solo tiene sentido con JS (revelados, botón Copiar). Va en línea y
        antes de pintar para que no haya parpadeo. */}
    {/* `html.lite`: sin escenario 3D (ahorro de datos, movimiento reducido, colores forzados o más
        contraste, poca memoria o pocos núcleos). Se decide aquí, antes de pintar, para que las
        ventanas del 3D no aparezcan y desaparezcan después (handoff v2 §6). `html.pausa`: el giro
        de la pila detenido por el botón de la cabecera (WCAG 2.2.2), recordado entre visitas. */}
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        try {
          var n = navigator;
          var c = n.connection;
          if (
            (c && c.saveData) ||
            matchMedia('(prefers-reduced-motion: reduce), (forced-colors: active), (prefers-contrast: more)').matches ||
            (n.deviceMemory || 8) < 4 ||
            (n.hardwareConcurrency || 4) < 4
          )
            d.classList.add('lite');
          if (localStorage.getItem('pila-pausa') === '1') d.classList.add('pausa');
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
