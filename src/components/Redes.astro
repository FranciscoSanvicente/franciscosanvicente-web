---
/* Lista de redes compartida por Hero y Contacto. Solo pinta las que tienen URL; si no hay ninguna,
   no pinta nada (nunca un `href="#"`). */
import { redes } from '../data/perfil';

interface Props {
  /** Nombre accesible de la lista, distinto en cada sección. */
  label?: string;
}

const { label = 'Redes' } = Astro.props;
---

{
  redes.length > 0 && (
    <ul class="redes" role="list" aria-label={label}>
      {redes.map((red) => (
        <li>
          <a class="link-arrow" href={red.url} rel="me">
            <span class="redes__nombre">{red.nombre}</span><span class="arrow" aria-hidden="true">↗</span>
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .redes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .redes a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-1);
    min-height: 44px;
    font-family: var(--font-mono);
    font-size: 0.9375rem;
    font-weight: 500;
    /* El subrayado va solo bajo el nombre: en un inline-flex cruzaría también la flecha. */
    text-decoration: none;
  }

  .redes__nombre {
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
    text-underline-offset: 0.2em;
    transition: text-decoration-color 160ms ease-out;
  }

  .redes a:hover .redes__nombre,
  .redes a:focus-visible .redes__nombre {
    text-decoration-color: currentColor;
  }
</style>
