---
/* "Cómo pienso" (docs/design/handoff.md §4, Principios). Tres posiciones de Francisco sobre cómo
   construye software, como ingeniero y no solo como dueño de Sumari (handoff v2). Borrador para
   que él las revise. Viven aquí y no en src/data/perfil.ts porque solo esta sección las pinta. */

interface Posicion {
  /** Índice visible: capa 05 → 5.1, 5.2, 5.3. */
  indice: string;
  afirmacion: string;
  detalle: string;
}

const POSICIONES: Posicion[] = [
  {
    indice: '5.1',
    afirmacion: 'Primero lo que resuelve el problema.',
    detalle:
      'Prefiero lanzar algo pequeño que funcione bien a prometer algo grande. Lo demás llega cuando hace falta de verdad.',
  },
  {
    indice: '5.2',
    afirmacion: 'Construyo pensando en el teléfono que la gente tiene en la mano.',
    detalle:
      'Equipos de gama media, conexiones que se caen y datos caros. Si una app va bien ahí, va bien en cualquier lado.',
  },
  {
    indice: '5.3',
    afirmacion: 'Me hago cargo de todo el camino.',
    detalle:
      'La pantalla, la API, la base de datos y el despliegue. Ver el producto completo me deja tomar mejores decisiones en cada parte.',
  },
];
---

<section id="principios" class="section container" data-clave="principios" aria-labelledby="h-principios">
  <div class="escena" aria-hidden="true"></div>
  <div class="principios grid">
    <div class="section-head principios__head">
      <p class="eyebrow" aria-hidden="true">capa 05</p>
      <h2 id="h-principios" class="t-h2">Cómo pienso</h2>
    </div>

    <ol class="principios__lista" role="list">
      {
        POSICIONES.map((p, i) => (
          <li class="posicion reveal" style={`--reveal-i: ${i}`}>
            <p class="eyebrow" aria-hidden="true">{p.indice}</p>
            <h3 class="t-statement">{p.afirmacion}</h3>
            <p class="t-body posicion__detalle">{p.detalle}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  /* Móvil y tableta: una sola columna, cabecera encima de la lista. */
  .principios__head,
  .principios__lista {
    grid-column: 1 / -1;
  }

  .principios__lista {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .posicion {
    display: grid;
    gap: var(--s-3);
    padding-block: var(--s-6);
    border-top: 1px solid var(--border);
  }

  .posicion__detalle {
    color: var(--ink3);
    text-wrap: pretty;
  }

  /* Escritorio: cabecera fija en las columnas 1–4 mientras la lista corre en 6–12. */
  @media (min-width: 64rem) {
    .principios__head {
      grid-column: 1 / span 4;
      align-self: start;
      position: sticky;
      top: var(--s-9);
      margin-bottom: 0;
    }

    .principios__lista {
      grid-column: 6 / -1;
    }
  }
</style>
