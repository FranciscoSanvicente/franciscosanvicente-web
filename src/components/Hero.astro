---
/* Hero (docs/design/handoff.md, v2 §2 y §4). El nombre domina y es la capa delantera de la escena:
   la pila vive en el escenario fijo detrás (Escenario.astro) y su base asoma tras «Sanvicente». El
   H1 nunca lleva `.reveal`: es el LCP y se pinta con el primer render.

   Legibilidad: un velo (`::before` del bloque de texto, detrás del texto y delante del canvas)
   protege nombre, lede y redes. Sigue al bloque, no a porcentajes de la pantalla: en retrato cubre
   el texto a todo el ancho y se funde 3rem por encima; en escritorio llega hasta el final del
   apellido y se funde en 4vw, así la base de la pila queda tras la «e» sin que nada se lea mal.

   Sin JS o en modo ligero (`html.lite`) no hay escenario: el hero pinta su propio póster, a la
   derecha en escritorio y bajo las redes en móvil. No es perezoso: en móvil es el LCP. */
import Redes from './Redes.astro';
import { perfil, redes } from '../data/perfil';
---

<section id="inicio" class="hero container" data-clave="inicio" aria-labelledby="nombre">
  <div class="hero__texto">
    <h1 id="nombre" class="hero__nombre t-name">{perfil.nombre}</h1>
    <p class="hero__lede t-lede reveal" style="--reveal-i:0">{perfil.lede}</p>
    {/* Sin redes con URL no se pinta el envoltorio: así no queda un hueco de `--s-7` vacío. */}
    {
      redes.length > 0 && (
        <div class="hero__redes reveal" style="--reveal-i:1">
          <Redes label="Redes de Francisco" />
        </div>
      )
    }
  </div>
  <picture class="hero__poster">
    <source srcset="/poster/pila.avif" type="image/avif" />
    <img src="/poster/pila.webp" width="960" height="960" alt="" decoding="async" />
  </picture>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: grid;
    align-content: end;
    min-height: calc(100svh - var(--header-h));
    padding-top: var(--s-9);
    padding-bottom: var(--s-8);
  }

  /* `min-content` corta en cada espacio: nombre y apellido siempre en dos líneas. */
  .hero__nombre {
    width: min-content;
  }

  .hero__lede {
    margin-top: var(--s-5);
  }

  .hero__redes {
    margin-top: var(--s-7);
  }

  .hero__texto {
    position: relative;
    justify-self: start;
    width: fit-content;
    max-width: 100%;
  }

  /* Velo: solo cuando hay escenario detrás. En retrato, a todo el ancho de la ventana. */
  :global(html.js:not(.lite)) .hero__texto::before {
    content: '';
    position: absolute;
    inset: -3rem auto calc(-1 * var(--s-8)) calc(-1 * var(--gutter));
    width: 100vw;
    z-index: -1;
    background: linear-gradient(to bottom, transparent, var(--scrim) 3rem);
  }

  /* Póster propio solo sin escenario (sin JS o modo ligero). */
  .hero__poster {
    display: none;
  }

  :global(html:not(.js)) .hero__poster,
  :global(html.lite) .hero__poster {
    display: block;
    width: min(72vw, 360px);
    margin-top: var(--s-7);
  }

  .hero__poster img {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: 0;
    }

    /* Escritorio: desde el borde de la ventana hasta el final del bloque de texto, y 4vw de fundido. */
    :global(html.js:not(.lite)) .hero__texto::before {
      inset: -2rem auto -2rem calc(50% - 50vw);
      width: auto;
      right: -4vw;
      background: linear-gradient(to left, transparent, var(--scrim) 4vw);
    }

    /* Sin escenario, el póster va a la derecha, en el sitio de la pila. */
    :global(html:not(.js)) .hero__poster,
    :global(html.lite) .hero__poster {
      position: absolute;
      left: calc(78vw - (100vw - 100%) / 2);
      top: 48%;
      z-index: -2;
      width: min(80svh, 40vw);
      margin: 0;
      translate: -50% -50%;
    }
  }
</style>
