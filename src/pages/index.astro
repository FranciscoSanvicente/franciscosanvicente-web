---
/* Composición de la página de inicio. Cada sección vive en su componente; este archivo solo decide
   el orden (docs/design/handoff.md, v2 §2). La pila 3D vive en el Escenario, una capa fija detrás de
   todo; cada sección se identifica con `data-clave` para que el cargador sepa qué pose toca. */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Escenario from '../components/Escenario.astro';
import Hero from '../components/Hero.astro';
import Servicios from '../components/Servicios.astro';
import Sumari from '../components/Sumari.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Stack from '../components/Stack.astro';
import Principios from '../components/Principios.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { perfil, sumari } from '../data/perfil';
---

<Base
  title={`${perfil.nombre} — ${perfil.rol}, creador de ${sumari.nombre}`}
  description={perfil.descripcion}
  preloadImage="/poster/pila.avif"
>
  <Escenario />
  <Header />
  <main id="contenido">
    <Hero />
    <Servicios />
    <Sumari />
    <Trayectoria />
    <Stack />
    <Principios />
    <Contacto />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/reveal';
</script>
