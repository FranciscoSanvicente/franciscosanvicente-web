---
import Base from '../layouts/Base.astro';
---

<Base
  title="Francisco Sanvicente — Fundador de Sumari"
  description="Francisco Sanvicente es desarrollador full stack y fundador de Sumari, la app de finanzas personales para quien maneja su dinero en varias monedas. Puerto Ordaz, Venezuela."
>
  <main id="contenido" class="placeholder">
    <h1>Francisco Sanvicente</h1>
    <p>Fundador de Sumari. Construyo finanzas para quien vive en varias monedas.</p>
  </main>
</Base>

<style>
  /* Página provisional de la fase 0: solo comprueba fuentes, tokens y build.
     La composición real llega en la fase 1. */
  .placeholder {
    min-height: 100dvh;
    display: grid;
    place-content: center;
    gap: 1rem;
    padding: 1.5rem;
  }

  h1 {
    font-size: clamp(2.75rem, 9vw, 6.5rem);
  }

  p {
    color: var(--ink3);
    font-size: 1.125rem;
  }
</style>
