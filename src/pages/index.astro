---
/* Composición de la página de inicio. Cada sección vive en su componente; este archivo solo decide
   el orden y qué secciones comparten el escenario del 3D (docs/design/handoff.md §1). */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Stage from '../components/Stage.astro';
import Hero from '../components/Hero.astro';
import Sumari from '../components/Sumari.astro';
import Trayectoria from '../components/Trayectoria.astro';
import Principios from '../components/Principios.astro';
import Contacto from '../components/Contacto.astro';
import Footer from '../components/Footer.astro';
import { perfil } from '../data/perfil';
---

<Base title={`${perfil.nombre} — ${perfil.rol}`} description={perfil.bioCorta}>
  <Header />
  <main id="contenido">
    <Stage>
      <Hero />
      <Sumari />
      <Trayectoria />
    </Stage>
    <Principios />
    <Contacto />
  </main>
  <Footer />
</Base>

<script>
  import '../scripts/reveal';
</script>
